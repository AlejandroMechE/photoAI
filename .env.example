# ==============================================================================
# FACE DATASET STUDIO - CLOUD CREDENTIALS TEMPLATE (.env.example)
# Copy this file to .env and fill in your team's shared Cloudinary credentials.
# ==============================================================================

# OPTION 1: Full API Environment Variable URL (from Cloudinary Dashboard)
CLOUDINARY_URL=cloudinary://1234567890:abcde_secret_key@your_cloud_name

# OPTION 2: Individual Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=abcde_secret_key

STORAGE_MODE=cloud
